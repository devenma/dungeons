# Godot 4+ generated; ignore editor/import junk.
.godot/
*.translation
*.import
.import/
export.cfg
export_presets.cfg
.mono/
data_*/
*.apk
*.aab

# GDExtension C header — generated by Godot, not needed for GDScript projects
gdextension_interface.h

# Godot resource UID files — auto-generated, not needed in version control
*.gd.uid
*.tscn.uid

# Configuracion personalizada de vscode
.vscode

# Art references (local moodboards, not game assets)
assets/References/

# Ignore Atlassian IDE files
.atl
# Caché de Python de tools/art
__pycache__/

# Pruebas de arte (capturas, renders y scripts de prueba): se guardan en local, no se versionan
art/pruebas/
